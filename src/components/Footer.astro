---
import { site } from '../site';
---

<footer class="border-t border-ink/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-10 text-sm text-muted sm:flex-row sm:justify-between sm:px-6">
    <p>
      © {new Date().getFullYear()} {site.name} · Made for students at {site.school}.
      <span class="km" lang="km">បង្កើតសម្រាប់សិស្សនៅ {site.school}។</span>
    </p>
    <p>
      Keep practicing! <span lang="km" class="font-khmer">បន្តហាត់រៀន!</span> 💪
    </p>
  </div>
</footer>
