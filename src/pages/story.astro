---
// THE STORY PAGE: "A Day in Nary's Life", a cartoon story that plays like a
// video. Each scene is a drawing (SVG) plus one English line and its Khmer
// caption. **Bold** words in the English are past simple verbs.
// Press ▶ Play: a voice reads each scene, then the next scene slides in.
//
// KHMER VOICE: put recordings in public/story/ named km-1.m4a … km-6.m4a
// (or .mp3), one per scene. When "ខ្មែរ" is chosen, the story plays them.
// Without a recording, it tries the phone's own Khmer voice, if it has one.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Nary from '../components/story/Nary.astro';
import Kid from '../components/story/Kid.astro';

const title = "A Day in Nary's Life";
const titleKm = 'មួយថ្ងៃរបស់ណារី';

// The words of the story. Change them here.
const scenes = [
  {
    en: 'Nary **woke up** at 6 o’clock. She **brushed** her teeth and **washed** her face.',
    km: 'ណារីបានក្រោកពីដំណេកនៅម៉ោង ៦។ នាងបានដុសធ្មេញ និងលាងមុខ។',
  },
  {
    en: 'She **ate** rice soup with her family.',
    km: 'នាងបានញ៉ាំបបរជាមួយគ្រួសាររបស់នាង។',
  },
  {
    en: 'Then she **rode** her bike to school.',
    km: 'បន្ទាប់មក នាងបានជិះកង់ទៅសាលារៀន។',
  },
  {
    en: 'At school, she **studied** English and **played** with her friends.',
    km: 'នៅសាលា នាងបានរៀនភាសាអង់គ្លេស ហើយលេងជាមួយមិត្តភក្តិ។',
  },
  {
    en: 'After school, she **helped** her mother at the market.',
    km: 'ក្រោយម៉ោងសិក្សា នាងបានជួយម្តាយរបស់នាងនៅផ្សារ។',
  },
  {
    en: 'At night, she **did** her homework and **went** to bed at 9 o’clock.',
    km: 'នៅពេលយប់ នាងបានធ្វើកិច្ចការផ្ទះ ហើយចូលគេងនៅម៉ោង ៩។',
  },
];

const bold = (text: string) => text.replace(/\*\*(.+?)\*\*/g, '<b class="rounded bg-sun/40 px-1">$1</b>');
const plain = (text: string) => text.replace(/\*\*/g, '');
// Finds the Khmer recording for each scene, if there is one.
const kmAudio = scenes.map((_, i) => {
  const file = ['m4a', 'mp3'].map((ext) => `km-${i + 1}.${ext}`).find((name) => fs.existsSync(path.join(process.cwd(), 'public/story', name)));
  return file ? `/story/${file}` : '';
});
const stars = [[40, 30], [90, 60], [150, 25], [210, 50], [260, 20], [330, 45], [370, 80], [120, 95], [300, 100], [20, 110]];
---

<Base title={title}>
  <Header />
  <main class="bg-gradient-to-b from-[#eef0ff] to-paper py-10 sm:py-14">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="text-center text-sm font-bold tracking-widest text-brand">🎬 CARTOON STORY · រឿងតុក្កតា</p>
      <h1 class="mt-2 text-center font-display text-3xl font-extrabold sm:text-5xl">
        {title}
        <span class="km" lang="km">{titleKm}</span>
      </h1>

      <!-- The "video" -->
      <div class="mt-8 overflow-hidden rounded-3xl bg-white shadow-[0_10px_0_#d9dcf7] ring-2 ring-brand/15">
        <div id="screen" class="relative aspect-[5/3] overflow-hidden bg-ink">
          <!-- Scene 1: morning, brushing teeth -->
          <svg data-scene viewBox="0 0 400 240" class="scene absolute inset-0 size-full" role="img" aria-label="Morning. Nary wakes up and brushes her teeth.">
            <rect width="400" height="240" fill="#fff4dc" />
            <rect x="40" y="40" width="110" height="80" rx="6" fill="#bfe6ff" stroke="#c98a4b" stroke-width="6" />
            <path d="M95 40 L95 120 M40 80 L150 80" stroke="#c98a4b" stroke-width="4" />
            <circle cx="125" cy="62" r="12" fill="#ffd36b" />
            <rect x="270" y="50" width="70" height="50" rx="8" fill="#dff1ff" stroke="#9aa8b8" stroke-width="3" />
            <rect x="260" y="120" width="90" height="60" rx="6" fill="#e9eef3" />
            <rect y="200" width="400" height="40" fill="#e3c9a3" />
            <rect x="40" y="150" width="120" height="40" rx="8" fill="#f7a8c4" />
            <rect x="40" y="140" width="34" height="18" rx="6" fill="#fff" />
            <Nary x={230} y={210} item="toothbrush" eyes="happy" home />
            <text x="180" y="40" font-family="sans-serif" font-size="18" font-weight="800" fill="#e2475b">⏰ 6:00</text>
          </svg>

          <!-- Scene 2: breakfast with the family -->
          <svg data-scene viewBox="0 0 400 240" class="scene absolute inset-0 size-full" role="img" aria-label="Nary eats rice soup with her family.">
            <rect width="400" height="240" fill="#fde9d2" />
            <rect y="200" width="400" height="40" fill="#d8b98a" />
            <Kid x={110} y={175} scale={1.35} shirt="#7fb2e5" />
            <Nary x={200} y={175} scale={1.05} eyes="happy" home />
            <Kid x={290} y={175} scale={1.4} girl shirt="#c2378a" />
            <rect x="60" y="150" width="280" height="14" rx="4" fill="#9c5a2e" />
            <rect x="80" y="164" width="10" height="40" fill="#7a4b2a" />
            <rect x="310" y="164" width="10" height="40" fill="#7a4b2a" />
            <g fill="#fff" stroke="#d6d6d6">
              <path d="M95 136 Q110 156 125 136 Z" /><path d="M185 136 Q200 156 215 136 Z" /><path d="M275 136 Q290 156 305 136 Z" />
            </g>
            <g stroke="#bbb" stroke-width="2" fill="none" opacity="0.8">
              <path d="M200 130 Q196 122 200 114 Q204 106 200 98" /><path d="M110 130 Q106 122 110 114" /><path d="M290 130 Q286 122 290 114" />
            </g>
            <text x="340" y="50" font-size="22">🥣</text>
          </svg>

          <!-- Scene 3: riding a bike to school -->
          <svg data-scene viewBox="0 0 400 240" class="scene absolute inset-0 size-full" role="img" aria-label="Nary rides her bike to school.">
            <rect width="400" height="240" fill="#bfe6ff" />
            <circle cx="340" cy="45" r="22" fill="#ffe27a" />
            <g fill="#fff" opacity="0.9"><ellipse cx="80" cy="45" rx="30" ry="12" /><ellipse cx="200" cy="30" rx="26" ry="10" /></g>
            <g>
              <rect x="300" y="100" width="90" height="80" fill="#f4e3c3" />
              <path d="M290 102 L345 70 L400 102 Z" fill="#e2475b" />
              <text x="345" y="135" text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="800" fill="#4053d6">SCHOOL</text>
              <rect x="335" y="150" width="20" height="30" fill="#7a4b2a" />
            </g>
            <rect y="180" width="400" height="60" fill="#8ccf6a" />
            <path d="M0 205 L400 205 L400 235 L0 235 Z" fill="#9a9a9a" />
            <path d="M0 220 L400 220" stroke="#fff" stroke-width="3" stroke-dasharray="18 14" />
            <g transform="translate(150 215)">
              <g fill="none" stroke="#2b2620" stroke-width="4">
                <circle cx="-30" cy="0" r="18" /><circle cx="30" cy="0" r="18" />
              </g>
              <path d="M-30 0 L-8 -26 L22 -26 L30 0 M-8 -26 L0 0 L22 -26 M22 -26 L18 -38" stroke="#e2475b" stroke-width="4" fill="none" stroke-linejoin="round" />
              <rect x="-14" y="-30" width="14" height="4" rx="2" fill="#2b2620" />
              <rect x="12" y="-40" width="14" height="4" rx="2" fill="#2b2620" />
