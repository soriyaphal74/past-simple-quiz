            </g>
            <Nary x={142} y={208} item="bag" eyes="happy" />
            <g stroke="#4053d6" stroke-width="3" stroke-linecap="round" opacity="0.5">
              <path d="M70 180 L95 180" /><path d="M60 195 L90 195" />
            </g>
          </svg>

          <!-- Scene 4: English class and playing with friends -->
          <svg data-scene viewBox="0 0 400 240" class="scene absolute inset-0 size-full" role="img" aria-label="At school Nary studies English and plays with her friends.">
            <rect width="400" height="240" fill="#e8f4ff" />
            <rect x="20" y="25" width="170" height="95" rx="6" fill="#2f5d3a" stroke="#7a4b2a" stroke-width="6" />
            <text x="105" y="58" text-anchor="middle" font-family="sans-serif" font-size="14" font-weight="700" fill="#fff">I played.</text>
            <text x="105" y="82" text-anchor="middle" font-family="sans-serif" font-size="14" font-weight="700" fill="#ffe27a">She studied.</text>
            <text x="105" y="106" text-anchor="middle" font-family="sans-serif" font-size="12" fill="#cde">ABC ✏️</text>
            <rect y="190" width="400" height="50" fill="#9fd36f" />
            <circle cx="255" cy="185" r="12" fill="#ff7a59" />
            <path d="M244 181 Q255 176 266 181 M244 189 Q255 194 266 189" stroke="#fff" stroke-width="2" fill="none" />
            <Kid x={215} y={210} scale={1.2} />
            <Nary x={295} y={210} scale={1.05} wave eyes="happy" />
            <Kid x={355} y={212} scale={1.15} girl shirt="#fff" />
            <text x="250" y="60" font-size="22">🎉</text>
          </svg>

          <!-- Scene 5: helping mother at the market -->
          <svg data-scene viewBox="0 0 400 240" class="scene absolute inset-0 size-full" role="img" aria-label="After school Nary helps her mother at the market.">
            <rect width="400" height="240" fill="#ffe7c2" />
            <path d="M40 60 L360 60 L340 30 L60 30 Z" fill="#e2475b" />
            <path d="M60 30 L100 60 M100 30 L140 60 M140 30 L180 60 M180 30 L220 60 M220 30 L260 60 M260 30 L300 60 M300 30 L340 60" stroke="#fff" stroke-width="8" opacity="0.6" />
            <rect x="50" y="60" width="8" height="120" fill="#7a4b2a" />
            <rect x="342" y="60" width="8" height="120" fill="#7a4b2a" />
            <rect y="190" width="400" height="50" fill="#c9a77a" />
            <g transform="translate(170 205)">
              <path d="M-16 0 L16 0 L12 -60 L-12 -60 Z" fill="#2e8b6e" />
              <path d="M-12 -60 L12 -60 L10 -72 L-10 -72 Z" fill="#f7d77a" />
              <circle cx="0" cy="-86" r="14" fill="#c98c5f" />
              <path d="M-15 -86 Q-14 -103 0 -103 Q14 -103 15 -86 Q4 -95 -15 -86 Z" fill="#1e1612" />
              <circle cx="0" cy="-104" r="6" fill="#1e1612" />
              <path d="M-5 -79 Q0 -75 5 -79" stroke="#1e1612" stroke-width="1.6" fill="none" />
              <g stroke="#1e1612" stroke-width="1.6" fill="none"><path d="M-8 -86 Q-5 -89 -2 -86" /><path d="M2 -86 Q5 -89 8 -86" /></g>
            </g>
            <Nary x={235} y={205} eyes="happy" home />
            <rect x="60" y="140" width="280" height="18" rx="4" fill="#9c5a2e" />
            <g>
              <text x="75" y="138" font-size="22">🥭</text><text x="105" y="138" font-size="22">🍌</text>
              <text x="270" y="138" font-size="22">🥬</text><text x="300" y="138" font-size="22">🍉</text>
            </g>
            <text x="200" y="100" font-family="sans-serif" font-size="13" font-weight="800" fill="#7a4b2a" text-anchor="middle">❤️</text>
          </svg>

          <!-- Scene 6: homework and bedtime -->
          <svg data-scene viewBox="0 0 400 240" class="scene absolute inset-0 size-full" role="img" aria-label="At night Nary does her homework and goes to bed.">
            <rect width="400" height="240" fill="#232860" />
            <rect x="250" y="30" width="110" height="80" rx="6" fill="#1b1f4a" stroke="#c98a4b" stroke-width="6" />
            <circle cx="320" cy="62" r="16" fill="#fff4c2" />
            <circle cx="328" cy="57" r="14" fill="#1b1f4a" />
            {stars.map(([sx, sy]) => sx > 250 && sy < 100 && <text x={sx} y={sy + 20} font-size="9" fill="#ffe27a">✦</text>)}
            <rect y="200" width="400" height="40" fill="#3a3f7a" />
            <!-- desk with lamp light -->
            <path d="M60 60 L20 160 L140 160 Z" fill="#ffe27a" opacity="0.18" />
            <rect x="20" y="160" width="140" height="10" rx="3" fill="#9c5a2e" />
            <rect x="30" y="170" width="8" height="35" fill="#7a4b2a" /><rect x="142" y="170" width="8" height="35" fill="#7a4b2a" />
            <path d="M60 60 L50 158 M45 60 L75 60 L68 48 L52 48 Z" stroke="#ccc" stroke-width="3" fill="#f4b33d" />
            <rect x="80" y="150" width="34" height="10" fill="#fff" />
            <!-- bed -->
            <rect x="200" y="160" width="180" height="30" rx="8" fill="#f7a8c4" />
            <rect x="200" y="150" width="50" height="22" rx="8" fill="#fff" />
            <rect x="240" y="155" width="140" height="22" rx="8" fill="#7b5ea7" />
            <circle cx="232" cy="152" r="13" fill="#c98c5f" />
            <path d="M219 150 Q220 136 233 137 Q246 138 245 150 Q236 142 219 150 Z" fill="#1e1612" />
            <g stroke="#1e1612" stroke-width="1.6" fill="none"><path d="M225 153 Q228 155 231 153" /><path d="M235 153 Q238 155 241 153" /></g>
            <text x="250" y="130" font-family="sans-serif" font-size="18" font-weight="800" fill="#cbd1ff" opacity="0.8">z z z</text>
            <text x="20" y="40" font-family="sans-serif" font-size="18" font-weight="800" fill="#ffe27a">🕘 9:00</text>
          </svg>

          <!-- Big play button over the picture at the start -->
          <button id="big-play" type="button" class="absolute inset-0 flex items-center justify-center bg-ink/30 text-white">
            <span class="flex size-20 items-center justify-center rounded-full bg-sun text-4xl text-ink shadow-[0_6px_0_#b9822a]">▶</span>
          </button>
        </div>

        <!-- Words of the scene -->
        <div class="p-5 sm:p-6">
          {
            scenes.map((s, i) => (
              <div data-words class={i === 0 ? '' : 'hidden'} data-km-audio={kmAudio[i]}>
                <p class="text-lg leading-relaxed sm:text-xl" set:html={bold(s.en)} data-say={plain(s.en)} />
                <p class="km mt-1 text-base" lang="km" data-say-km={s.km}>{s.km}</p>
              </div>
            ))
          }

          <!-- Controls -->
          <div class="mt-5 flex items-center justify-between gap-3">
            <button id="prev" type="button" class="rounded-full bg-ink/5 px-4 py-3 font-bold hover:bg-ink/10" aria-label="Previous scene">◀</button>
            <div id="dots" class="flex gap-2">
              {scenes.map((_, i) => <button type="button" data-dot={i} aria-label={`Scene ${i + 1}`} class="size-3 rounded-full bg-ink/15" />)}
            </div>
            <button id="next" type="button" class="rounded-full bg-ink/5 px-4 py-3 font-bold hover:bg-ink/10" aria-label="Next scene">▶</button>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3">
            <button id="play" type="button" class="col-span-2 rounded-full bg-brand px-5 py-3 font-bold text-paper shadow-[0_5px_0_#2f3fae] active:translate-y-1 active:shadow-none">▶ Play story</button>
            <div class="flex rounded-full bg-ink/5 p-1" role="group" aria-label="Voice language">
              <button type="button" data-lang="en" class="flex-1 rounded-full px-3 py-2 font-bold">English</button>
              <button type="button" data-lang="km" lang="km" class="flex-1 rounded-full px-3 py-2 font-bold font-khmer">ខ្មែរ</button>
            </div>
            <button id="sound" type="button" class="rounded-full bg-ink/5 px-5 py-3 font-bold hover:bg-ink/10">🔊 Voice on</button>
          </div>
          <p id="km-note" lang="km" class="mt-3 hidden rounded-xl bg-sun/20 p-3 text-center text-sm">
            ទូរសព្ទនេះមិនមានសំឡេងខ្មែរទេ។ សូមអានអក្សរខ្មែរខាងលើ។ 📖
          </p>
        </div>
      </div>

      <!-- Practice -->
      <div class="mt-8 rounded-3xl bg-white p-6 ring-1 ring-ink/5">
        <h2 class="font-display text-2xl font-bold">
          🔍 Find the past simple verbs!
          <span class="km" lang="km">រកកិរិយាសព្ទកាលអតីតសាមញ្ញ!</span>
        </h2>
        <p class="mt-2 text-muted">
          The yellow words are past simple. Can you say the base verb? (woke up → wake up)
          <span class="km" lang="km">ពាក្យពណ៌លឿងជាកាលអតីតសាមញ្ញ។ តើអ្នកអាចនិយាយកិរិយាសព្ទដើមបានទេ? (woke up → wake up)</span>
        </p>
        <a href="/#quiz" class="mt-5 inline-block rounded-full bg-sun px-6 py-3 font-extrabold text-ink shadow-[0_5px_0_#b9822a] active:translate-y-1 active:shadow-none">
          🎮 Play the quiz <span lang="km" class="font-khmer font-semibold">លេងការធ្វើតេស្ត</span>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  /* Scenes fade in and slowly zoom, like a cartoon film. */
  .scene {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .scene.on {
    opacity: 1;
    animation: drift 9s ease-out forwards;
  }
  @keyframes drift {
    from { transform: scale(1); }
    to { transform: scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene.on { animation: none; }
  }
</style>

<script>
  // Plays the story: shows one scene at a time, reads its words out loud,
  // then moves on to the next scene.
  const scenes = [...document.querySelectorAll<SVGElement>('[data-scene]')];
  const words = [...document.querySelectorAll<HTMLElement>('[data-words]')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-dot]')];
  const playButton = document.getElementById('play')!;
  const soundButton = document.getElementById('sound')!;
  const bigPlay = document.getElementById('big-play')!;

  let current = 0;
  let playing = false;
  let voiceOn = true;
  let lang: 'en' | 'km' = 'en';
  let timer: number | undefined;
  let recording: HTMLAudioElement | null = null;
  const canSpeak = 'speechSynthesis' in window;
  const langButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-lang]')];
  const kmNote = document.getElementById('km-note')!;

  // Does this phone or computer have its own Khmer voice?
  const hasKhmerVoice = () => canSpeak && speechSynthesis.getVoices().some((v) => v.lang.toLowerCase().startsWith('km'));

  function drawLang() {
    langButtons.forEach((b) => {
      const on = b.dataset.lang === lang;
      b.classList.toggle('bg-white', on);
      b.classList.toggle('shadow', on);
      b.classList.toggle('text-brand', on);
    });
    // Warn when Khmer is chosen but there is no recording and no Khmer voice.
    const missing = lang === 'km' && words.some((w) => !w.dataset.kmAudio) && !hasKhmerVoice();
    kmNote.classList.toggle('hidden', !missing);
  }

  function show(i: number) {
    current = (i + scenes.length) % scenes.length;
    scenes.forEach((s, n) => s.classList.toggle('on', n === current));
    words.forEach((w, n) => w.classList.toggle('hidden', n !== current));
    dots.forEach((d, n) => {
      d.classList.toggle('bg-brand', n === current);
      d.classList.toggle('bg-ink/15', n !== current);
    });
  }

  function stopTalking() {
    clearTimeout(timer);
    if (canSpeak) speechSynthesis.cancel();
    recording?.pause();
    recording = null;
  }

  // Read this scene, then go to the next one (or stop at the end).
  // Khmer: a recording if there is one, else the device's Khmer voice,
  // else no sound (the scene just waits a little longer).
  function runScene() {
    stopTalking();
    if (!playing) return;
    const scene = words[current];
    const goOn = () => {
      if (!playing) return;
      if (current === scenes.length - 1) return setPlaying(false);
      show(current + 1);
      runScene();
    };
    const afterVoice = () => (timer = window.setTimeout(goOn, 900));
    const silent = () => (timer = window.setTimeout(goOn, lang === 'km' ? 7000 : 5500));

    if (!voiceOn) return silent();
    if (lang === 'km' && scene.dataset.kmAudio) {
      recording = new Audio(scene.dataset.kmAudio);
      recording.onended = afterVoice;
      recording.play().catch(silent);
      return;
    }
    if (!canSpeak || (lang === 'km' && !hasKhmerVoice())) return silent();
    const say = new SpeechSynthesisUtterance(
      lang === 'km' ? scene.querySelector<HTMLElement>('[data-say-km]')!.dataset.sayKm! : scene.querySelector<HTMLElement>('[data-say]')!.dataset.say!,
    );
    say.lang = lang === 'km' ? 'km-KH' : 'en-US';
    say.rate = 0.85;
    say.onend = afterVoice;
    speechSynthesis.speak(say);
  }

  function setPlaying(on: boolean) {
    playing = on;
    playButton.textContent = on ? '⏸ Pause' : '▶ Play story';
    bigPlay.classList.add('hidden');
    if (on) runScene();
    else stopTalking();
  }

  playButton.addEventListener('click', () => {
    if (!playing && current === scenes.length - 1) show(0);
    setPlaying(!playing);
  });
  bigPlay.addEventListener('click', () => {
    show(0);
    setPlaying(true);
  });
  soundButton.addEventListener('click', () => {
    voiceOn = !voiceOn;
    soundButton.textContent = voiceOn ? '🔊 Voice on' : '🔇 Voice off';
    if (playing) runScene();
  });
  document.getElementById('prev')!.addEventListener('click', () => {
    show(current - 1);
    if (playing) runScene();
  });
  document.getElementById('next')!.addEventListener('click', () => {
    show(current + 1);
    if (playing) runScene();
  });
  dots.forEach((d, n) =>
    d.addEventListener('click', () => {
      show(n);
      if (playing) runScene();
    }),
  );
  langButtons.forEach((b) =>
    b.addEventListener('click', () => {
      lang = b.dataset.lang as 'en' | 'km';
      drawLang();
      if (playing) runScene();
    }),
  );
  // Voices can load a moment after the page; check again when they arrive.
  if (canSpeak) speechSynthesis.addEventListener('voiceschanged', drawLang);

  show(0);
  drawLang();
</script>
