---
// The homepage: a short lesson on the past simple, then the quiz.
// The questions and rules come from src/quiz.ts. Every class="km" line is
// the Khmer caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
import { questions, questionsPerRound, rules } from '../quiz';
---

<Base>
  <Header />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-br from-brand via-[#6d4ce0] to-[#e2457f] text-white">
      <!-- Floating emojis in the background -->
      <div class="pointer-events-none absolute inset-0 select-none text-4xl opacity-60 sm:text-5xl sm:opacity-90" aria-hidden="true">
        <span class="anim-float absolute top-[12%] left-[6%]">📚</span>
        <span class="anim-float absolute top-[18%] right-[8%] [animation-delay:-1s]">⭐</span>
        <span class="anim-float absolute bottom-[14%] left-[10%] [animation-delay:-2s]">✏️</span>
        <span class="anim-float absolute right-[12%] bottom-[10%] [animation-delay:-3s]">🏆</span>
        <span class="anim-float absolute top-[55%] left-[2%] hidden [animation-delay:-1.5s] sm:block">🕰️</span>
        <span class="anim-float absolute top-[50%] right-[3%] hidden [animation-delay:-2.5s] sm:block">💬</span>
      </div>
      <div class="relative mx-auto max-w-3xl px-4 pt-16 pb-20 text-center sm:px-6 sm:pt-24">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/20 px-4 py-1.5 text-sm font-semibold backdrop-blur">
          🎮 {questionsPerRound} questions · {site.school}
        </p>
        <h1 class="mt-6 font-display text-5xl font-extrabold leading-[1.05] tracking-tight sm:text-7xl">
          Past Simple <span class="text-sun">Quiz!</span>
          <span class="km" lang="km">ការធ្វើតេស្ត កាលអតីតសាមញ្ញ</span>
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-lg text-white/90">
          Choose the right verb, build a 🔥 streak, and win ⭐⭐⭐!
          <span class="km" lang="km">ជ្រើសរើសកិរិយាសព្ទត្រឹមត្រូវ បង្កើតស៊េរី 🔥 ហើយឈ្នះ ⭐⭐⭐!</span>
        </p>
        <a href="#quiz" class="anim-pop mt-8 inline-block rounded-full bg-sun px-10 py-4 text-xl font-extrabold text-ink shadow-[0_6px_0_#b9822a] transition hover:-translate-y-0.5 active:translate-y-1 active:shadow-none">
          ▶ Play now <span lang="km" class="font-khmer font-semibold">លេងឥឡូវនេះ</span>
        </a>
      </div>
    </section>

    <!-- Rules -->
    <section id="rules" class="scroll-mt-20 bg-white/60 py-12">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2 class="text-center font-display text-3xl font-bold">
          3 rules to remember
          <span class="km" lang="km">ច្បាប់ ៣ ដែលត្រូវចងចាំ</span>
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            rules.map((r) => (
              <div class="rounded-2xl bg-paper p-6 ring-1 ring-ink/5">
                <p class="text-3xl">{r.icon}</p>
                <h3 class="mt-3 font-display text-lg font-bold">
                  {r.title}
                  <span class="km" lang="km">{r.titleKm}</span>
                </h3>
                <p class="mt-3 rounded-lg bg-sun/15 px-3 py-2 font-mono text-sm">{r.examples}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Quiz -->
    <section id="quiz" class="scroll-mt-20 bg-gradient-to-b from-[#eef0ff] to-paper py-14">
      <div class="mx-auto max-w-2xl px-4 sm:px-6">
        <div class="rounded-3xl bg-white p-6 shadow-[0_10px_0_#d9dcf7] ring-2 ring-brand/15 sm:p-8">
          <!-- Question screen -->
          <div id="q-screen">
            <div class="flex items-center justify-between gap-2 text-sm font-bold">
              <span id="q-count" class="rounded-full bg-brand/10 px-3 py-1 text-brand">Question 1 / {questionsPerRound}</span>
              <span class="flex items-center gap-2">
                <span id="q-streak-box" class="rounded-full bg-orange-100 px-3 py-1 text-orange-600 opacity-40 transition">🔥 <span id="q-streak">0</span></span>
                <span class="rounded-full bg-sun/25 px-3 py-1">⭐ <span id="q-score">0</span></span>
              </span>
            </div>
            <!-- One dot per question: green = right, red = wrong -->
            <div id="q-dots" class="mt-4 flex justify-center gap-1.5"></div>

            <p class="mt-8 text-center font-display text-2xl leading-snug font-bold sm:text-3xl" id="q-sentence"></p>
            <p class="mt-2 text-center text-muted">
              Verb <span lang="km">កិរិយាសព្ទ</span>: <b id="q-verb" class="text-ink"></b>
            </p>

            <div id="q-options" class="mt-8 grid grid-cols-2 gap-3"></div>

            <div id="q-feedback" class="mt-6 hidden rounded-2xl p-4"></div>

            <button id="q-next" type="button" class="mt-6 hidden w-full rounded-full bg-brand px-6 py-4 text-lg font-bold text-paper shadow-[0_5px_0_#2f3fae] active:translate-y-1 active:shadow-none">
              Next → <span lang="km" class="font-khmer font-normal">បន្ទាប់</span>
            </button>
          </div>

          <!-- Result screen -->
          <div id="r-screen" class="hidden text-center">
            <p id="r-emoji" class="anim-pop text-7xl"></p>
            <p id="r-stars" class="mt-3 text-4xl tracking-widest"></p>
            <p class="mt-2 font-display text-5xl font-extrabold">
              <span id="r-score"></span> / <span id="r-total"></span>
            </p>
            <p id="r-message" class="mt-3 text-lg"></p>
            <div id="r-review" class="mt-8 hidden text-left">
              <h3 class="font-display text-xl font-bold">
                Practice these again
                <span class="km" lang="km">ហាត់រៀនពាក្យទាំងនេះម្តងទៀត</span>
              </h3>
              <ul id="r-list" class="mt-3 space-y-2"></ul>
            </div>
            <p class="mt-6 text-muted">Best streak <span lang="km">ស៊េរីល្អបំផុត</span>: <b class="text-orange-600">🔥 <span id="r-best"></span></b></p>
            <button id="r-again" type="button" class="mt-8 w-full rounded-full bg-sun px-6 py-4 text-lg font-extrabold text-ink shadow-[0_5px_0_#b9822a] active:translate-y-1 active:shadow-none">
              🔁 Try again <span lang="km" class="font-khmer font-normal">សាកល្បងម្តងទៀត</span>
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script type="application/json" id="quiz-data" set:html={JSON.stringify({ questions, questionsPerRound })} />

<script>
  // Runs the quiz like a game: picks random questions, mixes up the answers,
  // checks each answer with a little animation, counts a 🔥 streak, and shows
  // stars and the score at the end.
  type Question = {
    sentence: string;
    verb: string;
    options: string[];
    why: string;
    whyKm: string;
  };

  const data = JSON.parse(document.getElementById('quiz-data')!.textContent!) as {
    questions: Question[];
    questionsPerRound: number;
  };

  // Game-show colors and shapes for the 4 answer buttons.
  const BUTTONS = [
    { shape: '▲', color: 'bg-[#e2475b] shadow-[0_5px_0_#a8293b]' },
    { shape: '◆', color: 'bg-[#2f7fe0] shadow-[0_5px_0_#1d58a3]' },
    { shape: '●', color: 'bg-[#e9a320] shadow-[0_5px_0_#a8720e]' },
    { shape: '■', color: 'bg-[#2ea44f] shadow-[0_5px_0_#1d7535]' },
  ];
  const PRAISE = ['Great!', 'Super!', 'Yes!', 'Awesome!', 'Nice!'];

  const $ = (id: string) => document.getElementById(id)!;
  const shuffle = <T,>(list: T[]) => {
    const copy = [...list];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  };
  const escape = (text: string) => text.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

  // Restarts a CSS animation on an element (e.g. 'anim-pop').
  function play(el: Element, animation: string) {
    el.classList.remove(animation);
    void (el as HTMLElement).offsetWidth;
    el.classList.add(animation);
  }

  // Little emojis that fall from the middle of the screen.
  function confetti(emojis: string[], count = 18) {
    for (let i = 0; i < count; i++) {
      const bit = document.createElement('span');
      bit.className = 'confetti-bit';
      bit.textContent = emojis[i % emojis.length];
      bit.style.left = `${10 + Math.random() * 80}vw`;
      bit.style.setProperty('--dx', `${(Math.random() - 0.5) * 30}vw`);
      bit.style.setProperty('--spin', `${(Math.random() - 0.5) * 720}deg`);
      bit.style.animationDelay = `${Math.random() * 0.25}s`;
      document.body.append(bit);
      setTimeout(() => bit.remove(), 1800);
    }
  }

  let round: Question[] = [];
  let results: boolean[] = [];
  let index = 0;
  let score = 0;
  let streak = 0;
  let bestStreak = 0;
  let mistakes: Question[] = [];

  function start() {
    round = shuffle(data.questions).slice(0, data.questionsPerRound);
    results = [];
    index = 0;
    score = 0;
    streak = 0;
    bestStreak = 0;
    mistakes = [];
    $('r-screen').classList.add('hidden');
    $('q-screen').classList.remove('hidden');
    show();
  }

  function drawDots() {
    $('q-dots').innerHTML = round
      .map((_, i) => {
        const color =
          i < results.length ? (results[i] ? 'bg-[#2ea44f]' : 'bg-[#e2475b]') : i === index ? 'bg-brand scale-125' : 'bg-ink/15';
        return `<span class="size-3 rounded-full transition ${color}"></span>`;
      })
      .join('');
  }

  function drawStreak() {
    $('q-streak').textContent = String(streak);
    $('q-streak-box').classList.toggle('opacity-40', streak < 2);
  }

  function show() {
    const q = round[index];
    const right = q.options[0];
    $('q-count').textContent = `Question ${index + 1} / ${round.length}`;
    $('q-score').textContent = String(score);
    drawDots();
    drawStreak();
    $('q-sentence').innerHTML = escape(q.sentence).replace(
      '___',
      '<span id="q-blank" class="inline-block min-w-20 rounded-lg border-b-4 border-dashed border-brand bg-brand/5 px-2 text-brand">&nbsp;?&nbsp;</span>',
    );
    $('q-verb').textContent = `(${q.verb})`;
    $('q-feedback').className = 'mt-6 hidden rounded-2xl p-4';
    $('q-next').classList.add('hidden');

    const options = $('q-options');
    options.innerHTML = '';
    shuffle(q.options).forEach((choice, i) => {
      const look = BUTTONS[i % BUTTONS.length];
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.choice = choice;
      button.innerHTML = `<span class="text-base opacity-80">${look.shape}</span> ${escape(choice)}`;
      button.className = `flex items-center justify-center gap-2 rounded-2xl px-3 py-5 text-xl font-extrabold text-white transition ${look.color} hover:-translate-y-0.5 active:translate-y-1 active:shadow-none disabled:cursor-default disabled:hover:translate-y-0`;
      button.addEventListener('click', () => answer(choice, right));
      options.append(button);
    });
  }

  function answer(choice: string, right: string) {
    const q = round[index];
    const correct = choice === right;
    results.push(correct);
    if (correct) {
      score++;
      streak++;
      bestStreak = Math.max(bestStreak, streak);
    } else {
      streak = 0;
      mistakes.push(q);
    }

    // Right answer jumps with a ✔, a wrong pick shakes, the others fade.
    for (const button of $('q-options').querySelectorAll<HTMLButtonElement>('button')) {
      button.disabled = true;
      if (button.dataset.choice === right) {
        button.classList.add('ring-4', 'ring-offset-2', 'ring-[#2ea44f]');
        button.insertAdjacentHTML('beforeend', ' ✔');
        play(button, 'anim-pop');
      } else if (button.dataset.choice === choice) {
        play(button, 'anim-shake');
        button.classList.add('opacity-70');
      } else {
        button.classList.add('opacity-25');
      }
    }
    $('q-blank').textContent = right;
    $('q-score').textContent = String(score);
    drawDots();
    drawStreak();
    if (correct) {
      play($('q-blank'), 'anim-pop');
      confetti(streak >= 3 ? ['🔥', '⭐', '🎉'] : ['⭐', '✨', '🎉']);
      if (streak >= 2) play($('q-streak-box'), 'anim-pop');
    }

    const praise = PRAISE[Math.floor(Math.random() * PRAISE.length)];
    const feedback = $('q-feedback');
    feedback.className = `mt-6 rounded-2xl border-2 p-4 ${correct ? 'border-[#2ea44f]/30 bg-[#2ea44f]/10' : 'border-[#e2475b]/30 bg-[#e2475b]/10'}`;
    feedback.innerHTML = `
      <p class="text-lg font-extrabold">${
        correct
          ? `✅ ${praise} <span lang="km">ត្រឹមត្រូវ!</span>${streak >= 2 ? ` <span class="text-orange-600">🔥 ${streak} in a row!</span>` : ''}`
          : '❌ Not quite. <span lang="km">មិនទាន់ត្រូវទេ។</span>'
      }</p>
      <p class="mt-1">${escape(q.why)}</p>
      <p class="km" lang="km">${escape(q.whyKm)}</p>`;

    const next = $('q-next');
    next.innerHTML =
      index + 1 < round.length
        ? 'Next → <span lang="km" class="font-khmer font-normal">បន្ទាប់</span>'
        : 'See my score 🎉 <span lang="km" class="font-khmer font-normal">មើលពិន្ទុ</span>';
    next.classList.remove('hidden');
    next.focus({ preventScroll: true });
  }

  function finish() {
    $('q-screen').classList.add('hidden');
    $('r-screen').classList.remove('hidden');
    $('r-score').textContent = String(score);
    $('r-total').textContent = String(round.length);
    $('r-best').textContent = String(bestStreak);

    const percent = score / round.length;
    const stars = percent === 1 ? 3 : percent >= 0.7 ? 2 : percent >= 0.4 ? 1 : 0;
    $('r-stars').textContent = '⭐'.repeat(stars) + '☆'.repeat(3 - stars);
    const [emoji, message] =
      percent === 1
        ? ['🏆', 'Perfect! You are a past simple star! <span lang="km" class="km">ល្អឥតខ្ចោះ! អ្នកជាតារាកាលអតីត!</span>']
        : percent >= 0.7
          ? ['🎉', 'Great job! <span lang="km" class="km">ធ្វើបានល្អណាស់!</span>']
          : percent >= 0.4
            ? ['👍', 'Good try! Practice a little more. <span lang="km" class="km">ព្យាយាមបានល្អ! ហាត់បន្ថែមបន្តិចទៀត។</span>']
            : ['💪', 'Keep going! Read the rules and try again. <span lang="km" class="km">បន្តទៀត! អានច្បាប់ ហើយសាកល្បងម្តងទៀត។</span>'];
    $('r-emoji').textContent = emoji;
    play($('r-emoji'), 'anim-pop');
    $('r-message').innerHTML = message;
    if (stars >= 2) confetti(['🎉', '⭐', '🏆', '✨'], 36);

    const list = $('r-list');
    list.innerHTML = mistakes
      .map(
        (q) =>
          `<li class="rounded-xl bg-paper p-3 ring-1 ring-ink/5"><b>${escape(q.verb)} → ${escape(q.options[0])}</b><br><span class="text-muted">${escape(q.sentence.replace('___', q.options[0]))}</span></li>`,
      )
      .join('');
    $('r-review').classList.toggle('hidden', mistakes.length === 0);
    $('quiz').scrollIntoView({ behavior: 'smooth' });
  }

  $('q-next').addEventListener('click', () => {
    index++;
    if (index < round.length) show();
    else finish();
  });
  $('r-again').addEventListener('click', () => {
    start();
    $('quiz').scrollIntoView({ behavior: 'smooth' });
  });

  start();
</script>
